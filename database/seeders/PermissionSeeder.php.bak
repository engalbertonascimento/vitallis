<?php

namespace Database\Seeders;

use App\Models\Permission;
use Illuminate\Database\Seeder;

class PermissionSeeder extends Seeder
{
    public function run(): void
    {
        $permissions = [
            // Dashboard
            ['name' => 'Visualizar dashboard', 'slug' => 'dashboard.view'],

            // Pacientes
            ['name' => 'Visualizar pacientes', 'slug' => 'patients.view'],
            ['name' => 'Cadastrar pacientes', 'slug' => 'patients.create'],
            ['name' => 'Editar pacientes', 'slug' => 'patients.update'],

            // Agenda
            ['name' => 'Visualizar agenda', 'slug' => 'appointments.view'],
            ['name' => 'Criar agendamentos', 'slug' => 'appointments.create'],
            ['name' => 'Editar agendamentos', 'slug' => 'appointments.update'],
            ['name' => 'Cancelar agendamentos', 'slug' => 'appointments.cancel'],

            // Prontuário
            ['name' => 'Visualizar prontuário', 'slug' => 'medical_records.view'],
            ['name' => 'Criar registros no prontuário', 'slug' => 'medical_records.create'],
            ['name' => 'Editar registros no prontuário', 'slug' => 'medical_records.update'],

            // Prescrições
            ['name' => 'Visualizar prescrições', 'slug' => 'prescriptions.view'],
            ['name' => 'Criar prescrições', 'slug' => 'prescriptions.create'],

            // Exames
            ['name' => 'Visualizar exames', 'slug' => 'exams.view'],
            ['name' => 'Criar solicitações de exames', 'slug' => 'exams.create'],

            // Usuários
            ['name' => 'Visualizar usuários', 'slug' => 'users.view'],
            ['name' => 'Cadastrar usuários', 'slug' => 'users.create'],
            ['name' => 'Editar usuários', 'slug' => 'users.update'],

            // Relatórios
            ['name' => 'Visualizar relatórios', 'slug' => 'reports.view'],

            // Redes
            ['name' => 'Visualizar redes', 'slug' => 'network.view'],
            ['name' => 'Gerenciar redes', 'slug' => 'network.manage'],

            // Unidades
            ['name' => 'Visualizar unidades', 'slug' => 'unit.view'],
            ['name' => 'Gerenciar unidades', 'slug' => 'unit.manage'],

            // Auditoria
            ['name' => 'Visualizar auditoria', 'slug' => 'audit.view'],
        ];

        foreach ($permissions as $permission) {
            Permission::updateOrCreate(
                ['slug' => $permission['slug']],
                $permission
            );
        }
    }
}