        || $user->hasPermission('schedules.update')
        || $user->hasPermission('schedules.block');

    $previousDate = $date->copy()->subDay()->format('Y-m-d');
    $nextDate = $date->copy()->addDay()->format('Y-m-d');

    $baseFilters = request()->only([
        'professional_id',
        'specialty_id',
        'status',
    ]);
@endphp

